{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathpath.vn/schemas/problem-set-import-v1.json",
  "title": "MathPath Problem Set Import v1",
  "description": "Validated, unpublished review input. Runtime validation source of truth: src/lib/problems/import-schema.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "problem_set", "questions"],
  "properties": {
    "format_version": { "const": 1 },
    "problem_set": { "$ref": "#/$defs/problemSet" },
    "questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "problemSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "title",
        "description",
        "language",
        "category",
        "source_type",
        "source_year",
        "timing_mode",
        "time_limit_seconds",
        "estimated_duration_seconds",
        "exam_metadata",
        "source_document",
        "provenance_status",
        "publication_rights_status",
        "review_status",
        "publication_status"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "slug": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "language": { "enum": ["vi", "en"] },
        "category": { "enum": ["mock_exam", "chapter_review", "topic_review", "comprehensive"] },
        "source_type": { "enum": ["official_exam", "practice_book", "generated"] },
        "source_year": { "type": ["integer", "null"], "minimum": 1900, "maximum": 2200 },
        "timing_mode": { "enum": ["countdown", "elapsed"] },
        "time_limit_seconds": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "Mock exams use 5400 seconds (90 minutes); practice sets use null."
        },
        "estimated_duration_seconds": { "type": ["integer", "null"], "minimum": 1 },
        "exam_metadata": { "type": "object" },
        "source_document": { "type": ["string", "null"] },
        "provenance_status": {
          "enum": ["source_imported", "unknown", "pending_review", "verified"]
        },
        "publication_rights_status": {
          "enum": [
            "unknown",
            "pending_review",
            "approved_for_internal",
            "approved_for_publication",
            "restricted"
          ]
        },
        "review_status": { "enum": ["draft", "needs_review"] },
        "publication_status": { "enum": ["draft", "unpublished"] }
      },
      "allOf": [
        {
          "if": { "properties": { "timing_mode": { "const": "countdown" } } },
          "then": { "properties": { "time_limit_seconds": { "type": "integer", "minimum": 1 } } }
        },
        {
          "if": { "properties": { "timing_mode": { "const": "elapsed" } } },
          "then": { "properties": { "time_limit_seconds": { "type": "null" } } }
        },
        {
          "if": { "properties": { "category": { "const": "mock_exam" } } },
          "then": {
            "properties": {
              "timing_mode": { "const": "countdown" },
              "time_limit_seconds": { "const": 5400 },
              "estimated_duration_seconds": { "type": "null" }
            }
          }
        }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "text", "order_index"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "order_index": { "type": "integer", "minimum": 0 }
      }
    },
    "substatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "text", "order_index"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "order_index": { "type": "integer", "minimum": 0 }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "problem_set_id",
        "section",
        "question_number",
        "order_index",
        "statement",
        "question_type",
        "options",
        "substatements",
        "correct_answer",
        "explanation",
        "topic",
        "difficulty",
        "tags",
        "source_document",
        "source_page",
        "source_question_number",
        "source_type",
        "provenance_status",
        "publication_rights_status",
        "review_status",
        "publication_status"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "problem_set_id": { "type": "string", "format": "uuid" },
        "section": { "type": ["string", "null"] },
        "question_number": { "type": "string", "minLength": 1 },
        "order_index": { "type": "integer", "minimum": 0 },
        "statement": { "type": "string", "minLength": 1 },
        "question_type": { "enum": ["multiple_choice", "true_false", "short_answer"] },
        "options": { "type": "array", "items": { "$ref": "#/$defs/option" } },
        "substatements": { "type": "array", "items": { "$ref": "#/$defs/substatement" } },
        "correct_answer": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["type", "option_key"],
              "properties": {
                "type": { "const": "multiple_choice" },
                "option_key": { "type": "string", "minLength": 1 }
              }
            },
            {
              "type": "object",
              "required": ["type", "statements"],
              "properties": {
                "type": { "const": "true_false" },
                "statements": { "type": "object", "additionalProperties": { "type": "boolean" } }
              }
            },
            {
              "type": "object",
              "required": ["type", "accepted_values"],
              "properties": {
                "type": { "const": "short_answer" },
                "accepted_values": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                },
                "case_sensitive": { "type": "boolean" },
                "tolerance": { "type": "number", "minimum": 0 }
              }
            }
          ]
        },
        "explanation": { "type": ["string", "null"] },
        "topic": { "type": ["string", "null"] },
        "difficulty": { "enum": ["easy", "medium", "hard", null] },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "source_document": { "type": "string", "minLength": 1 },
        "source_page": { "type": "integer", "minimum": 1 },
        "source_question_number": { "type": "string", "minLength": 1 },
        "source_pages": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "image_path": { "type": "string", "minLength": 1 },
        "illustration_status": {
          "enum": ["not_required", "present", "possibly_missing", "missing", "needs_review"]
        },
        "extraction_status": { "enum": ["extracted", "needs_review", "error"] },
        "local_review_status": { "enum": ["pending", "approved", "needs_review"] },
        "source_type": { "enum": ["official_exam", "practice_book", "generated"] },
        "provenance_status": {
          "enum": ["source_imported", "unknown", "pending_review", "verified"]
        },
        "publication_rights_status": {
          "enum": [
            "unknown",
            "pending_review",
            "approved_for_internal",
            "approved_for_publication",
            "restricted"
          ]
        },
        "review_status": { "enum": ["draft", "needs_review"] },
        "publication_status": { "const": "unpublished" }
      },
      "allOf": [
        {
          "if": { "properties": { "question_type": { "const": "multiple_choice" } } },
          "then": {
            "properties": { "options": { "minItems": 2 }, "substatements": { "maxItems": 0 } }
          }
        },
        {
          "if": { "properties": { "question_type": { "const": "true_false" } } },
          "then": {
            "properties": { "substatements": { "minItems": 1 }, "options": { "maxItems": 0 } }
          }
        },
        {
          "if": { "properties": { "question_type": { "const": "short_answer" } } },
          "then": {
            "properties": { "options": { "maxItems": 0 }, "substatements": { "maxItems": 0 } }
          }
        }
      ]
    }
  }
}

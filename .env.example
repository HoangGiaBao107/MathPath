# Public application URL used for canonical metadata and auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase browser-safe project settings. Publishable key is preferred; legacy anon key is also supported.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Attempt storage mode: mock (local only) or supabase (durable PostgreSQL).
MATHPATH_ATTEMPT_STORE=mock

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_PROVIDER=
PAYMENT_BANK_CODE=
PAYMENT_BANK_ACCOUNT=
PAYMENT_ACCOUNT_NAME=
